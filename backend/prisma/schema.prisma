// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////
// ENUMS
//////////////////////////////////////

enum UserRole {
  ADMIN
  COMMERCIAL
}

//////////////////////////////////////
// BASE MODELS
//////////////////////////////////////

model User {
  id         String    @id @default(uuid()) 
  email      String    @unique
  password   String
  telephone  String?
  firstName  String?
  lastName   String?
  cin        String?
  role       UserRole  @default(COMMERCIAL)
  createdAt  DateTime  @default(now())
}

model Vehicle {
  id String @id @default(cuid())

  licensePlate String @unique

  type VehicleType

  sanitaryApprovalNo String?
  sanitaryExpiryDate DateTime?

  technicalControlDate DateTime?
  nextTechnicalControl DateTime?

  insurancePolicyNo String?
  insuranceCompany String?
  insuranceExpiryDate DateTime?

  medicalEquipment String?
  mileage Int?
  maintenancePlan String?

  status VehicleStatus @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum VehicleType {
  AMBULANCE
  VSL
  TPMR
  MEDICAL_MOTORBIKE
}

enum VehicleStatus {
  AVAILABLE
  IN_SERVICE
  IN_MAINTENANCE
  OUT_OF_SERVICE
}