// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////
// ENUMS
//////////////////////////////////////

enum UserRole {
  ADMIN
  COMMERCIAL
}

//////////////////////////////////////
// BASE MODELS
//////////////////////////////////////

model User {
  id         String    @id @default(uuid()) 
  email      String    @unique
  password   String
  telephone  String?
  firstName  String?
  lastName   String?
  cin        String?
  role       UserRole  @default(COMMERCIAL)
  createdAt  DateTime  @default(now())
}